@model Website_Cosmetics.Models.User
@{
    ViewData["Title"] = "Delete Staff";
}

<div class="page-header">
    <h1>Delete Staff</h1>
    <div>
        <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Are you sure you want to delete this staff member?</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <strong>Warning:</strong> This action cannot be undone. All associated data will be permanently deleted.
        </div>

        <dl class="detail-list">
            <div class="detail-item">
                <dt>User ID:</dt>
                <dd>@Model.UserId</dd>
            </div>
            <div class="detail-item">
                <dt>Username:</dt>
                <dd>@Model.Username</dd>
            </div>
            <div class="detail-item">
                <dt>Email:</dt>
                <dd>@Model.Email</dd>
            </div>
            <div class="detail-item">
                <dt>Full Name:</dt>
                <dd>@(Model.FullName ?? "N/A")</dd>
            </div>
            <div class="detail-item">
                <dt>Phone Number:</dt>
                <dd>@(Model.PhoneNumber ?? "N/A")</dd>
            </div>
            <div class="detail-item">
                <dt>Status:</dt>
                <dd>
                    @if (Model.IsActive == true)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </dd>
            </div>
            <div class="detail-item">
                <dt>Created At:</dt>
                <dd>@Model.CreatedAt.ToString("MM/dd/yyyy HH:mm:ss")</dd>
            </div>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    
    <div class="form-actions">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you absolutely sure you want to delete this staff member? This action cannot be undone.')">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/pages/staff-management.css" asp-append-version="true" />
}

