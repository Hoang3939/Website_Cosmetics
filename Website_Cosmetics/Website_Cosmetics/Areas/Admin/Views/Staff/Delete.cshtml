@model Website_Cosmetics.Models.User
@{
    ViewData["Title"] = "Delete Staff";
}

<div class="page-header">
    <div class="page-header__title">
    <h1>Delete Staff</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Are you sure you want to delete this staff member?</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <strong>Warning:</strong> This action cannot be undone. All associated data will be permanently deleted.
        </div>

        <dl class="detail-list">
            <div class="detail-item">
                <dt>User ID:</dt>
                <dd>@Model.UserId</dd>
            </div>
            <div class="detail-item">
                <dt>Username:</dt>
                <dd>@Model.Username</dd>
            </div>
            <div class="detail-item">
                <dt>Email:</dt>
                <dd>@Model.Email</dd>
            </div>
            <div class="detail-item">
                <dt>Full Name:</dt>
                <dd>@(Model.FullName ?? "N/A")</dd>
            </div>
            <div class="detail-item">
                <dt>Phone Number:</dt>
                <dd>@(Model.PhoneNumber ?? "N/A")</dd>
            </div>
            <div class="detail-item">
                <dt>Status:</dt>
                <dd>
                    @if (Model.IsActive == true)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </dd>
            </div>
            <div class="detail-item">
                <dt>Created At:</dt>
                <dd>@Model.CreatedAt.ToString("MM/dd/yyyy HH:mm:ss")</dd>
            </div>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.UserId" method="post" class="mt-4" id="deleteForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    
    <div class="form-actions">
        <button type="button" class="btn btn-danger" id="deleteBtn">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteModal" style="display: none;">
    <div class="modal-container">
        <div class="modal-header">
            <h3>Confirm Deletion</h3>
            <button type="button" class="modal-close" id="closeModal">&times;</button>
        </div>
        <div class="modal-body">
            <div class="alert alert-warning">
                <strong>Warning:</strong> This action cannot be undone. All associated data will be permanently deleted.
            </div>
            <p>Are you absolutely sure you want to delete this staff member?</p>
            <div class="modal-staff-info">
                <strong>@Model.Username</strong> (@Model.Email)
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelDelete">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmDelete">Yes, Delete</button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/pages/staff-management.css" asp-append-version="true" />
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/admin/js/staff-management.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const deleteBtn = document.getElementById('deleteBtn');
            const deleteModal = document.getElementById('deleteModal');
            const closeModal = document.getElementById('closeModal');
            const cancelDelete = document.getElementById('cancelDelete');
            const confirmDelete = document.getElementById('confirmDelete');
            const deleteForm = document.getElementById('deleteForm');

            // Show modal when delete button is clicked
            if (deleteBtn) {
                deleteBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    if (deleteModal) {
                        deleteModal.style.display = 'flex';
                    }
                });
            }

            // Close modal functions
            function closeModalFunc() {
                if (deleteModal) {
                    deleteModal.style.display = 'none';
                }
            }

            if (closeModal) {
                closeModal.addEventListener('click', closeModalFunc);
            }

            if (cancelDelete) {
                cancelDelete.addEventListener('click', closeModalFunc);
            }

            // Close modal when clicking outside
            if (deleteModal) {
                deleteModal.addEventListener('click', function(e) {
                    if (e.target === deleteModal) {
                        closeModalFunc();
                    }
                });
            }

            // Confirm delete - submit form
            if (confirmDelete && deleteForm) {
                confirmDelete.addEventListener('click', function() {
                    deleteForm.submit();
                });
            }

            // Close modal with Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && deleteModal && deleteModal.style.display === 'flex') {
                    closeModalFunc();
                }
            });
        });
    </script>
}

