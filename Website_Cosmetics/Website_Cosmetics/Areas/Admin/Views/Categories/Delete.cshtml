@model Website_Cosmetics.Models.Category
@{
    ViewData["Title"] = "Delete Category";
    var productCount = ViewBag.ProductCount as int? ?? (Model.Products?.Count() ?? 0);
}

<div class="page-header">
    <div class="page-header__title">
        <h1>Delete Category</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Are you sure you want to delete this category?</h3>
    </div>
    <div class="card-body">
        @if (productCount > 0)
        {
            <div class="alert alert-warning">
                <strong>Warning:</strong> This category is currently used by @productCount product(s). You must remove or reassign those products before deleting this category.
            </div>
        }
        else
        {
            <div class="alert alert-danger">
                <strong>Danger:</strong> This action cannot be undone.
            </div>
        }

        <dl class="detail-list">
            <div class="detail-item">
                <dt>Category ID</dt>
                <dd>@Model.CategoryId</dd>
            </div>
            <div class="detail-item">
                <dt>Name</dt>
                <dd>@Model.Name</dd>
            </div>
            <div class="detail-item">
                <dt>Description</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
            </div>
            <div class="detail-item">
                <dt>Status</dt>
                <dd>
                    @if ((Model.IsActive ?? true) == true)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </dd>
            </div>
            <div class="detail-item">
                <dt>Products</dt>
                <dd>@productCount</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="CategoryId" />
            <button type="submit" class="btn btn-danger" @(productCount > 0 ? "disabled" : null)>Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

