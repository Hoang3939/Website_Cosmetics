@model Website_Cosmetics.Models.ProductVariant
@{
    ViewData["Title"] = "Xóa Variant";
    var product = ViewBag.Product as Website_Cosmetics.Models.Product;
}

<div class="page-header">
    <div class="page-header__title">
        <h1>Xóa Variant</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-secondary">← Quay lại</a>
    </div>
</div>

<div class="alert alert-warning">
    <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa variant này? Hành động này không thể hoàn tác.
</div>

<div class="card">
    <div class="card-header">
        <h3>Thông tin Variant</h3>
    </div>
    <div class="card-body">
        <p><strong>Tên Variant:</strong> @Model.VariantName</p>
        <p><strong>Sản phẩm:</strong> @product?.Name</p>
        <p><strong>Màu sắc:</strong> @(Model.ColorName ?? "N/A")</p>
        <p><strong>Kích thước:</strong> @(Model.Size ?? "N/A")</p>
        <p><strong>Giá:</strong> @(Model.Price?.ToString("C") ?? "Dùng giá cơ bản")</p>
        <p><strong>Tồn kho:</strong> @Model.Stock</p>
        <p><strong>Số ảnh:</strong> @(Model.ProductVariantImages?.Count() ?? 0)</p>
    </div>
</div>

@if (Model.IsDefault)
{
    <div class="alert alert-info mt-3">
        <strong>Lưu ý:</strong> Đây là variant mặc định. Sau khi xóa, variant đầu tiên còn lại sẽ được đặt làm mặc định.
    </div>
}

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="VariantId" />
    
    <div class="form-actions mt-4">
        <button type="submit" class="btn btn-danger">Xác nhận Xóa</button>
        <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-secondary">Hủy</a>
    </div>
</form>

