@model Website_Cosmetics.Models.ProductVariant
@{
    ViewData["Title"] = "Delete Variant";
    var product = ViewBag.Product as Website_Cosmetics.Models.Product;
    var imageCount = Model.ProductVariantImages?.Count() ?? 0;
}

<div class="page-header">
    <div class="page-header__title">
        <h1>Delete Variant</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-secondary">← Back to Variants</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Are you sure you want to delete this variant?</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-danger">
            <strong>Warning:</strong> This action cannot be undone. All images associated with this variant will also be deleted.
        </div>

        @if (Model.IsDefault)
        {
            <div class="alert alert-info">
                <strong>Note:</strong> This is the default variant. After deletion, the first remaining variant will be set as default.
            </div>
        }

        <dl class="detail-list">
            <div class="detail-item">
                <dt>Variant ID</dt>
                <dd>@Model.VariantId</dd>
            </div>
            <div class="detail-item">
                <dt>Variant Name</dt>
                <dd>@Model.VariantName</dd>
            </div>
            <div class="detail-item">
                <dt>Product</dt>
                <dd>@(product?.Name ?? "N/A")</dd>
            </div>
            <div class="detail-item">
                <dt>Color</dt>
                <dd>@(Model.ColorName ?? "N/A")</dd>
            </div>
            <div class="detail-item">
                <dt>Size</dt>
                <dd>@(Model.Size ?? "N/A")</dd>
            </div>
            <div class="detail-item">
                <dt>Price</dt>
                <dd>@(Model.Price?.ToString("C") ?? "Use base price")</dd>
            </div>
            <div class="detail-item">
                <dt>Stock</dt>
                <dd>@Model.Stock</dd>
            </div>
            <div class="detail-item">
                <dt>Images</dt>
                <dd>@imageCount</dd>
            </div>
            <div class="detail-item">
                <dt>Status</dt>
                <dd>
                    @if (Model.IsActive == true)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </dd>
            </div>
            <div class="detail-item">
                <dt>Default</dt>
                <dd>
                    @if (Model.IsDefault == true)
                    {
                        <span class="badge badge-info">Yes</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary">No</span>
                    }
                </dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-actions" id="deleteForm" asp-route-id="@Model.VariantId">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="VariantId" />
            <button type="button" class="btn btn-danger" id="deleteBtn">Delete Variant</button>
            <a asp-action="Index" asp-route-productId="@Model.ProductId" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteModal" style="display: none;">
    <div class="modal-container">
        <div class="modal-header">
            <h3>Confirm Deletion</h3>
            <button type="button" class="modal-close" id="closeModal">&times;</button>
        </div>
        <div class="modal-body">
            <div class="alert alert-danger">
                <strong>Warning:</strong> This action cannot be undone. The variant and all its images will be permanently deleted.
            </div>
            <p>Are you sure you want to delete this variant?</p>
            <div class="modal-category-info">
                <strong>Variant Name:</strong> @Model.VariantName<br />
                <strong>Variant ID:</strong> @Model.VariantId<br />
                <strong>Product:</strong> @(product?.Name ?? "N/A")<br />
                <strong>Images:</strong> @imageCount
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelBtn">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Yes, Delete</button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/pages/categories.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteBtn = document.getElementById('deleteBtn');
            const deleteModal = document.getElementById('deleteModal');
            const closeModal = document.getElementById('closeModal');
            const cancelBtn = document.getElementById('cancelBtn');
            const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
            const deleteForm = document.getElementById('deleteForm');

            if (deleteBtn && deleteModal) {
                // Open modal when delete button is clicked
                deleteBtn.addEventListener('click', function () {
                    deleteModal.style.display = 'flex';
                });

                // Close modal functions
                function closeModalFunc() {
                    deleteModal.style.display = 'none';
                }

                closeModal?.addEventListener('click', closeModalFunc);
                cancelBtn?.addEventListener('click', closeModalFunc);

                // Close modal when clicking outside
                deleteModal.addEventListener('click', function (e) {
                    if (e.target === deleteModal) {
                        closeModalFunc();
                    }
                });

                // Close modal on Escape key
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && deleteModal.style.display === 'flex') {
                        closeModalFunc();
                    }
                });

                // Confirm deletion
                confirmDeleteBtn?.addEventListener('click', function () {
                    if (deleteForm) {
                        deleteForm.submit();
                    }
                });
            }
        });
    </script>
}

