@model Website_Cosmetics.Models.Order
@{
    ViewData["Title"] = "Update Order Status";
    var statusList = ViewBag.StatusList as List<string> ?? new List<string>();
    var paymentStatusList = ViewBag.PaymentStatusList as List<string> ?? new List<string>();
}

<div class="page-header">
    <div class="page-header__title">
        <h1>Update Order #@Model.OrderNumber</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-secondary">← Back to Details</a>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card">
    <div class="card-header">
        <h3>Status</h3>
    </div>
    <div class="card-body">
        <form asp-action="UpdateStatus" method="post" class="staff-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="OrderId" />

            <div class="form-row">
                <div class="form-group">
                    <label for="status">Order Status</label>
                    <select id="status" name="status" class="form-control" required>
                        @foreach (var s in statusList)
                        {
                            bool isDisabled = false;
                            string disabledReason = "";
                            
                            // Disable options if order is Delivered
                            if (Model.Status == "Delivered" && s != "Delivered")
                            {
                                isDisabled = true;
                                disabledReason = " (Cannot revert from Delivered)";
                            }
                            
                            // Disable options if order is Cancelled
                            if (Model.Status == "Cancelled" && s != "Cancelled")
                            {
                                isDisabled = true;
                                disabledReason = " (Cannot reactivate cancelled order)";
                            }
                            
                            <option value="@s" selected="@(Model.Status == s)" disabled="@isDisabled">@s@disabledReason</option>
                        }
                    </select>
                    <small class="form-text text-muted">
                        @if (Model.Status == "Delivered")
                        {
                            <span class="text-danger"><strong>Note:</strong> Orders with "Delivered" status cannot be reverted to previous statuses.</span>
                        }
                        else if (Model.Status == "Cancelled")
                        {
                            <span class="text-danger"><strong>Note:</strong> Cancelled orders cannot be reactivated.</span>
                        }
                        else
                        {
                            <span>Valid states: Pending, Processing, Shipped, Delivered, Cancelled.</span>
                        }
                    </small>
                </div>
                <div class="form-group">
                    <label for="paymentStatus">Payment Status</label>
                    <select id="paymentStatus" name="paymentStatus" class="form-control">
                        <option value="">(No change)</option>
                        @foreach (var ps in paymentStatusList)
                        {
                            <option value="@ps" selected="@(Model.PaymentStatus == ps)">@ps</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update</button>
                <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

