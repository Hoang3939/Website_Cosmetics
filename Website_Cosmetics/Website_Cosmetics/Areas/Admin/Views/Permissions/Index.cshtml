@model IEnumerable<Website_Cosmetics.Models.Permission>
@{
    ViewData["Title"] = "Permissions Management";
    var search = ViewBag.Search as string ?? "";
    var status = ViewBag.Status as string ?? "";
    var category = ViewBag.Category as string ?? "";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var pageSize = (int)(ViewBag.PageSize ?? 10);
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="page-header">
    <div class="page-header__title">
        <h1>Permissions Management</h1>
        <span class="page-header__count">@totalCount permission(s)</span>
    </div>
    <div class="page-header__actions">
        <a asp-action="Create" class="btn btn-primary">+ Add New Permission</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="staff-filter-form" id="filterForm">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="search">Search</label>
                    <input type="text" name="search" id="search" value="@search" placeholder="Search by name or description..." />
                </div>
                <div class="filter-group">
                    <label for="status">Status</label>
                    <select name="status" id="status">
                        <option value="">All</option>
                        <option value="active" selected="@(status == "active")">Active</option>
                        <option value="inactive" selected="@(status == "inactive")">Inactive</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="category">Category</label>
                    <select name="category" id="category">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat" selected="@(category == cat)">@cat</option>
                        }
                    </select>
                </div>
                <div class="filter-group filter-actions">
                    <button type="submit" class="btn btn-icon btn-primary" title="Apply filters">
                        <i data-lucide="filter"></i>
                        <span class="tooltip">Apply filters</span>
                    </button>
                    @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status) || !string.IsNullOrWhiteSpace(category))
                    {
                        <a asp-action="Index" class="btn btn-icon btn-secondary" title="Reset filters">
                            <i data-lucide="x"></i>
                            <span class="tooltip">Reset filters</span>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center">
            <p class="text-muted">No permissions found.</p>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table staff-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Permission Name</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Updated At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var permission in Model)
                    {
                        <tr>
                            <td>@permission.PermissionId</td>
                            <td>
                                <strong>@permission.PermissionName</strong>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(permission.Description) ? "—" : permission.Description)</td>
                            <td>@(string.IsNullOrWhiteSpace(permission.Category) ? "—" : permission.Category)</td>
                            <td>
                                @if (permission.IsActive)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactive</span>
                                }
                            </td>
                            <td>@permission.CreatedAt.ToString("MM/dd/yyyy")</td>
                            <td>@permission.UpdatedAt.ToString("MM/dd/yyyy")</td>
                            <td>
                                <div class="action-buttons">
                                    <a asp-action="Edit" asp-route-id="@permission.PermissionId" class="btn btn-sm btn-icon btn-primary" title="Edit">
                                        <i data-lucide="edit"></i>
                                        <span class="tooltip">Edit</span>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@permission.PermissionId" class="btn btn-sm btn-icon btn-danger" title="Delete">
                                        <i data-lucide="trash-2"></i>
                                        <span class="tooltip">Delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <div class="pagination-wrapper">
            <nav class="pagination">
                @if (currentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@search" asp-route-status="@status" asp-route-category="@category" class="pagination-link">Previous</a>
                }
                
                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                {
                    <a asp-action="Index" asp-route-page="@i" asp-route-search="@search" asp-route-status="@status" asp-route-category="@category" 
                       class="pagination-link @(i == currentPage ? "active" : "")">@i</a>
                }
                
                @if (currentPage < totalPages)
                {
                    <a asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@search" asp-route-status="@status" asp-route-category="@category" class="pagination-link">Next</a>
                }
            </nav>
            <div class="pagination-info">
                Page @currentPage of @totalPages (@totalCount total records)
            </div>
        </div>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/admin/css/pages/permissions-management.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/admin/js/admin-common.js" asp-append-version="true"></script>
}

