@model Website_Cosmetics.Models.Permission
@{
    ViewData["Title"] = "Delete Permission";
    var rolePermissionCount = ViewBag.RolePermissionCount as int? ?? (Model.RolePermissions?.Count() ?? 0);
    var userPermissionCount = ViewBag.UserPermissionCount as int? ?? (Model.UserPermissions?.Count() ?? 0);
    var totalUsage = rolePermissionCount + userPermissionCount;
}

<div class="page-header">
    <div class="page-header__title">
        <h1>Delete Permission</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Are you sure you want to delete this permission?</h3>
    </div>
    <div class="card-body">
        @if (totalUsage > 0)
        {
            <div class="alert alert-warning">
                <strong>Warning:</strong> This permission is currently used by @rolePermissionCount role(s) and @userPermissionCount user(s). You must remove those assignments before deleting this permission.
            </div>
        }
        else
        {
            <div class="alert alert-danger">
                <strong>Danger:</strong> This action cannot be undone.
            </div>
        }

        <dl class="detail-list">
            <div class="detail-item">
                <dt>Permission ID</dt>
                <dd>@Model.PermissionId</dd>
            </div>
            <div class="detail-item">
                <dt>Permission Name</dt>
                <dd>@Model.PermissionName</dd>
            </div>
            <div class="detail-item">
                <dt>Description</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>
            </div>
            <div class="detail-item">
                <dt>Category</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Category) ? "—" : Model.Category)</dd>
            </div>
            <div class="detail-item">
                <dt>Status</dt>
                <dd>
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </dd>
            </div>
            <div class="detail-item">
                <dt>Used By</dt>
                <dd>@rolePermissionCount role(s), @userPermissionCount user(s)</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-actions" id="deleteForm" asp-route-id="@Model.PermissionId">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PermissionId" />
            <button type="button" class="btn btn-danger" id="deleteBtn" @(totalUsage > 0 ? "disabled" : null)>Delete Permission</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (totalUsage == 0)
{
    <div class="modal-overlay" id="deleteModal" style="display: none;">
        <div class="modal-container">
            <div class="modal-header">
                <h3>Confirm Deletion</h3>
                <button type="button" class="modal-close" id="closeModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger">
                    <strong>Warning:</strong> This action cannot be undone. The permission will be permanently deleted.
                </div>
                <p>Are you sure you want to delete this permission?</p>
                <div class="modal-category-info">
                    <strong>Permission Name:</strong> @Model.PermissionName<br />
                    <strong>Permission ID:</strong> @Model.PermissionId
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelBtn">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Yes, Delete</button>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/admin/css/pages/permissions-management.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteBtn = document.getElementById('deleteBtn');
            const deleteModal = document.getElementById('deleteModal');
            const closeModal = document.getElementById('closeModal');
            const cancelBtn = document.getElementById('cancelBtn');
            const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
            const deleteForm = document.getElementById('deleteForm');

            if (deleteBtn && deleteModal) {
                // Open modal when delete button is clicked
                deleteBtn.addEventListener('click', function () {
                    deleteModal.style.display = 'flex';
                });

                // Close modal functions
                function closeModalFunc() {
                    deleteModal.style.display = 'none';
                }

                closeModal?.addEventListener('click', closeModalFunc);
                cancelBtn?.addEventListener('click', closeModalFunc);

                // Close modal when clicking outside
                deleteModal.addEventListener('click', function (e) {
                    if (e.target === deleteModal) {
                        closeModalFunc();
                    }
                });

                // Close modal on Escape key
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && deleteModal.style.display === 'flex') {
                        closeModalFunc();
                    }
                });

                // Confirm deletion
                confirmDeleteBtn?.addEventListener('click', function () {
                    if (deleteForm) {
                        deleteForm.submit();
                    }
                });
            }
        });
    </script>
}

