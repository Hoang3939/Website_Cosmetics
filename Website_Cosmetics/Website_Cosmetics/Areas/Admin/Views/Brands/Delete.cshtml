@model Website_Cosmetics.Models.Brand
@{
    ViewData["Title"] = "Delete Brand";
    var productCount = ViewBag.ProductCount as int? ?? (Model.Products?.Count() ?? 0);
}

<div class="page-header">
    <div class="page-header__title">
        <h1>Delete Brand</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Are you sure you want to delete this brand?</h3>
    </div>
    <div class="card-body">
        @if (productCount > 0)
        {
            <div class="alert alert-warning">
                <strong>⚠️ Cannot Delete:</strong> This brand is currently used by <strong>@productCount</strong> product(s). You must remove or reassign those products before deleting this brand.
                <br /><br />
                <small>To delete this brand, please:</small>
                <ul style="margin-top: 10px; margin-bottom: 0;">
                    <li>Go to Products management and remove or change the brand for all @productCount product(s)</li>
                    <li>Or set those products to a different brand</li>
                </ul>
            </div>
        }
        else
        {
            <div class="alert alert-danger">
                <strong>Danger:</strong> This action cannot be undone.
            </div>
        }

        <dl class="detail-list">
            <div class="detail-item">
                <dt>Brand ID</dt>
                <dd>@Model.BrandId</dd>
            </div>
            <div class="detail-item">
                <dt>Name</dt>
                <dd>@Model.Name</dd>
            </div>
            <div class="detail-item">
                <dt>Country</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Country) ? "—" : Model.Country)</dd>
            </div>
            <div class="detail-item">
                <dt>Status</dt>
                <dd>
                    @if ((Model.IsActive ?? true) == true)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </dd>
            </div>
            <div class="detail-item">
                <dt>Products</dt>
                <dd>@productCount</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-actions" id="deleteForm" asp-route-id="@Model.BrandId">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="BrandId" />
            <input type="hidden" id="productCount" value="@productCount" />
            <button type="button" class="btn btn-danger" id="deleteBtn" @(productCount > 0 ? "disabled" : null)>Delete Brand</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (productCount == 0)
{
    <div class="modal-overlay" id="deleteModal" style="display: none;">
        <div class="modal-container">
            <div class="modal-header">
                <h3>Confirm Deletion</h3>
                <button type="button" class="modal-close" id="closeModal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger">
                    <strong>Warning:</strong> This action cannot be undone. The brand will be permanently deleted.
                </div>
                <p>Are you sure you want to delete this brand?</p>
                <div class="modal-category-info">
                    <strong>Brand Name:</strong> @Model.Name<br />
                    <strong>Brand ID:</strong> @Model.BrandId
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelBtn">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Yes, Delete</button>
            </div>
        </div>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/admin/css/pages/brands.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteBtn = document.getElementById('deleteBtn');
            const deleteModal = document.getElementById('deleteModal');
            const closeModal = document.getElementById('closeModal');
            const cancelBtn = document.getElementById('cancelBtn');
            const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
            const deleteForm = document.getElementById('deleteForm');
            const productCountInput = document.getElementById('productCount');
            const productCount = productCountInput ? parseInt(productCountInput.value) : 0;

            // VALIDATION: Prevent form submission if brand has products
            if (deleteForm) {
                deleteForm.addEventListener('submit', function (e) {
                    if (productCount > 0) {
                        e.preventDefault();
                        alert(`Cannot delete brand. This brand is currently used by ${productCount} product(s). Please remove or reassign those products first.`);
                        return false;
                    }
                });
            }

            if (deleteBtn && deleteModal) {
                // VALIDATION: Disable delete button if brand has products
                if (productCount > 0) {
                    deleteBtn.disabled = true;
                    deleteBtn.title = `Cannot delete: ${productCount} product(s) are using this brand`;
                } else {
                    // Open modal when delete button is clicked
                    deleteBtn.addEventListener('click', function () {
                        deleteModal.style.display = 'flex';
                    });

                    // Close modal functions
                    function closeModalFunc() {
                        deleteModal.style.display = 'none';
                    }

                    closeModal?.addEventListener('click', closeModalFunc);
                    cancelBtn?.addEventListener('click', closeModalFunc);

                    // Close modal when clicking outside
                    deleteModal.addEventListener('click', function (e) {
                        if (e.target === deleteModal) {
                            closeModalFunc();
                        }
                    });

                    // Close modal on Escape key
                    document.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape' && deleteModal.style.display === 'flex') {
                            closeModalFunc();
                        }
                    });

                    // Confirm deletion
                    confirmDeleteBtn?.addEventListener('click', function () {
                        if (deleteForm) {
                            deleteForm.submit();
                        }
                    });
                }
            }
        });
    </script>
}

