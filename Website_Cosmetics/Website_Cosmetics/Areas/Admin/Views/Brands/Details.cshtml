@model Website_Cosmetics.Models.Brand
@{
    ViewData["Title"] = "Brand Details";
    var productCount = Model.Products?.Count() ?? 0;
}

<div class="page-header">
    <div class="page-header__title">
        <h1>Brand: @Model.Name</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
        <a asp-action="Edit" asp-route-id="@Model.BrandId" class="btn btn-primary">Edit</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card mb-4">
    <div class="card-header">
        <h3>Basic Information</h3>
    </div>
    <div class="card-body">
        <dl class="detail-list">
            <div class="detail-item">
                <dt>Brand ID</dt>
                <dd>@Model.BrandId</dd>
            </div>
            <div class="detail-item">
                <dt>Name</dt>
                <dd>@Model.Name</dd>
            </div>
            <div class="detail-item">
                <dt>Country</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Country) ? "—" : Model.Country)</dd>
            </div>
            <div class="detail-item">
                <dt>Status</dt>
                <dd>
                    @if ((Model.IsActive ?? true) == true)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </dd>
            </div>
            <div class="detail-item">
                <dt>Products</dt>
                <dd>@productCount</dd>
            </div>
            <div class="detail-item">
                <dt>Created At</dt>
                <dd>@Model.CreatedAt.ToString("MM/dd/yyyy HH:mm")</dd>
            </div>
            <div class="detail-item">
                <dt>Updated At</dt>
                <dd>@Model.UpdatedAt.ToString("MM/dd/yyyy HH:mm")</dd>
            </div>
        </dl>
    </div>
</div>

