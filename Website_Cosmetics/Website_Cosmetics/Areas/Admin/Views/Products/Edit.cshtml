@model Website_Cosmetics.Models.Product
@{
    ViewData["Title"] = "Edit Product";
}

<div class="page-header">
    <h1>Edit Product: @Model.Name</h1>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProductId" />

    <div class="form-group">
        <label asp-for="Name">Product Name *</label>
        <input asp-for="Name" class="form-control" required />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Slug">Slug</label>
        <input asp-for="Slug" class="form-control" />
        <small class="form-text text-muted">Leave empty to auto-generate from product name</small>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Brand</label>
                <select name="brandId" class="form-control">
                    <option value="">-- Select Brand --</option>
                    @if (ViewBag.Brands != null)
                    {
                        @foreach (var brand in (ViewBag.Brands as IEnumerable<Website_Cosmetics.Models.Brand>)!)
                        {
                            <option value="@brand.BrandId" selected="@(Model.BrandId == brand.BrandId)">@brand.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label>Category</label>
                <select name="categoryId" class="form-control">
                    <option value="">-- Select Category --</option>
                    @if (ViewBag.Categories != null)
                    {
                        @foreach (var category in (ViewBag.Categories as IEnumerable<Website_Cosmetics.Models.Category>)!)
                        {
                            <option value="@category.CategoryId" selected="@(Model.CategoryId == category.CategoryId)">@category.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="BasePrice">Base Price *</label>
                <input asp-for="BasePrice" type="number" step="0.01" class="form-control" required />
                <span asp-validation-for="BasePrice" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="SPF">SPF</label>
                <input asp-for="SPF" class="form-control" />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Size">Size</label>
                <input asp-for="Size" class="form-control" />
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="Finish">Finish</label>
                <input asp-for="Finish" class="form-control" />
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label asp-for="IsActive">Status</label>
                <select asp-for="IsActive" class="form-control">
                    <option value="true" selected="@(Model.IsActive == true)">Active</option>
                    <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
                </select>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Description">Description</label>
        <textarea asp-for="Description" class="form-control" rows="4">@Model.Description</textarea>
    </div>

    <div class="form-group">
        <label asp-for="Ingredients">Ingredients</label>
        <textarea asp-for="Ingredients" class="form-control" rows="4">@Model.Ingredients</textarea>
    </div>

    <hr />
    <h3>Product Images</h3>
    <p class="text-muted">Manage existing images and upload new ones. Set primary image and virtual try-on images.</p>

    @{
        var firstVariant = Model.ProductVariants.FirstOrDefault();
        var existingImages = firstVariant?.ProductVariantImages.OrderBy(img => img.DisplayOrder).ToList() ?? new List<Website_Cosmetics.Models.ProductVariantImage>();
    }

    @if (existingImages.Any())
    {
        <div class="row mb-3" id="existingImages">
            @for (int i = 0; i < existingImages.Count; i++)
            {
                var image = existingImages[i];
                <div class="col-md-3 mb-3" data-image-id="@image.ImageId">
                    <div class="card">
                        <img src="@image.Url" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@image.AltText" />
                        <div class="card-body">
                            <input type="hidden" name="existingImageIds" value="@image.ImageId" />
                            
                            <div class="form-check mb-2">
                                <input class="form-check-input primary-checkbox" 
                                       type="checkbox" 
                                       name="existingIsPrimary" 
                                       value="@i"
                                       @(image.IsPrimary ? "checked" : "")
                                       data-image-id="@image.ImageId"
                                       data-variant-id="@(firstVariant?.VariantId ?? 0)">
                                <label class="form-check-label">
                                    Set as Primary Image
                                </label>
                            </div>
                            
                            <div class="form-check mb-2">
                                <input class="form-check-input makeup-checkbox" 
                                       type="checkbox" 
                                       name="existingIsMakeupReference" 
                                       value="@i"
                                       @(image.IsMakeupReference ? "checked" : "")
                                       data-image-id="@image.ImageId">
                                <label class="form-check-label">
                                    Use for Virtual Try-On
                                </label>
                            </div>
                            
                            <input type="hidden" name="existingDisplayOrder" value="@i" />
                            
                            <button type="button" 
                                    class="btn btn-sm btn-danger btn-delete-image" 
                                    data-image-id="@image.ImageId">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="form-group">
        <label>Upload New Images</label>
        <input type="file" name="newVariantImages" multiple accept="image/*,.avif,.webp,image/avif,image/webp" class="form-control" id="newImageUpload" />
        <small class="form-text text-muted">You can select multiple images at once</small>
    </div>

    <div id="newImagePreview" class="row mt-3"></div>

    <div class="form-actions mt-4">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script>
        // Handle new image upload preview
        document.getElementById('newImageUpload').addEventListener('change', function(e) {
            const preview = document.getElementById('newImagePreview');
            preview.innerHTML = '';
            
            const files = e.target.files;
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const reader = new FileReader();
                
                reader.onload = function(e) {
                    const col = document.createElement('div');
                    col.className = 'col-md-3 mb-3';
                    
                    const imageIndex = document.querySelectorAll('#newImagePreview .col-md-3').length;
                    
                    col.innerHTML = `
                        <div class="card">
                            <img src="${e.target.result}" class="card-img-top" style="height: 200px; object-fit: cover;" />
                            <div class="card-body">
                                <div class="form-check">
                                    <input class="form-check-input new-primary-checkbox" 
                                           type="checkbox" 
                                           name="primaryImageIndices" 
                                           value="${imageIndex}" 
                                           id="new_primary_${imageIndex}">
                                    <label class="form-check-label" for="new_primary_${imageIndex}">
                                        Set as Primary Image
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input new-makeup-checkbox" 
                                           type="checkbox" 
                                           name="makeupReferenceIndices" 
                                           value="${imageIndex}" 
                                           id="new_makeup_${imageIndex}">
                                    <label class="form-check-label" for="new_makeup_${imageIndex}">
                                        Use for Virtual Try-On
                                    </label>
                                </div>
                            </div>
                        </div>
                    `;
                    
                    preview.appendChild(col);
                };
                
                reader.readAsDataURL(file);
            }

            // Attach event listeners after all images are loaded
            setTimeout(() => {
                attachNewImageCheckboxListeners();
            }, 100);
        });

        function attachNewImageCheckboxListeners() {
            // Handle primary image checkbox for new images - only one can be selected
            document.querySelectorAll('.new-primary-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        // Uncheck all other primary checkboxes (both existing and new)
                        document.querySelectorAll('.primary-checkbox, .new-primary-checkbox').forEach(cb => {
                            if (cb !== this) {
                                cb.checked = false;
                            }
                        });
                    }
                });
            });

            // Handle makeup reference checkbox for new images - only one can be selected
            document.querySelectorAll('.new-makeup-checkbox').forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        // Uncheck all other makeup reference checkboxes (both existing and new)
                        document.querySelectorAll('.makeup-checkbox, .new-makeup-checkbox').forEach(cb => {
                            if (cb !== this) {
                                cb.checked = false;
                            }
                        });
                    }
                });
            });
        }

        // Handle primary image checkbox for existing images - only one can be selected
        document.querySelectorAll('.primary-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                if (this.checked) {
                    // Uncheck all other primary checkboxes (both existing and new)
                    document.querySelectorAll('.primary-checkbox, .new-primary-checkbox').forEach(cb => {
                        if (cb !== this) {
                            cb.checked = false;
                        }
                    });
                }
            });
        });

        // Handle makeup reference checkbox for existing images - only one can be selected
        document.querySelectorAll('.makeup-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                if (this.checked) {
                    // Uncheck all other makeup reference checkboxes (both existing and new)
                    document.querySelectorAll('.makeup-checkbox, .new-makeup-checkbox').forEach(cb => {
                        if (cb !== this) {
                            cb.checked = false;
                        }
                    });
                }
            });
        });

        // Handle delete image button
        document.querySelectorAll('.btn-delete-image').forEach(button => {
            button.addEventListener('click', function() {
                const imageId = this.getAttribute('data-image-id');
                if (confirm('Are you sure you want to delete this image?')) {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    fetch('@Url.Action("DeleteImage", "Products")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ imageId: parseInt(imageId) })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            this.closest('.col-md-3').remove();
                        } else {
                            alert('Error deleting image: ' + (data.message || 'Unknown error'));
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('Error deleting image');
                    });
                }
            });
        });
    </script>
}

