@model Website_Cosmetics.Models.Product
@{
    ViewData["Title"] = "Delete Product";
    var variantCount = Model.ProductVariants?.Count() ?? 0;
}

<div class="page-header">
    <div class="page-header__title">
        <h1>Delete Product</h1>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-secondary">← Back to Products</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3>Are you sure you want to delete this product?</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-danger">
            <strong>Warning:</strong> This action cannot be undone. All variants and images associated with this product will also be deleted.
        </div>

        <dl class="detail-list">
            <div class="detail-item">
                <dt>Product ID</dt>
                <dd>@Model.ProductId</dd>
            </div>
            <div class="detail-item">
                <dt>Name</dt>
                <dd>@Model.Name</dd>
            </div>
            <div class="detail-item">
                <dt>Brand</dt>
                <dd>@(Model.Brand?.Name ?? "N/A")</dd>
            </div>
            <div class="detail-item">
                <dt>Category</dt>
                <dd>@(Model.Category?.Name ?? "N/A")</dd>
            </div>
            <div class="detail-item">
                <dt>Base Price</dt>
                <dd>@Model.BasePrice.ToString("C")</dd>
            </div>
            <div class="detail-item">
                <dt>Status</dt>
                <dd>
                    @if (Model.IsActive == true)
                    {
                        <span class="badge badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-danger">Inactive</span>
                    }
                </dd>
            </div>
            <div class="detail-item">
                <dt>Variants</dt>
                <dd>@variantCount</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-actions" id="deleteForm" asp-route-id="@Model.ProductId">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />
            <button type="button" class="btn btn-danger" id="deleteBtn">Delete Product</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteModal" style="display: none;">
    <div class="modal-container">
        <div class="modal-header">
            <h3>Confirm Deletion</h3>
            <button type="button" class="modal-close" id="closeModal">&times;</button>
        </div>
        <div class="modal-body">
            <div class="alert alert-danger">
                <strong>Warning:</strong> This action cannot be undone. The product and all its variants and images will be permanently deleted.
            </div>
            <p>Are you sure you want to delete this product?</p>
            <div class="modal-category-info">
                <strong>Product Name:</strong> @Model.Name<br />
                <strong>Product ID:</strong> @Model.ProductId<br />
                <strong>Variants:</strong> @variantCount
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" id="cancelBtn">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Yes, Delete</button>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/pages/categories.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteBtn = document.getElementById('deleteBtn');
            const deleteModal = document.getElementById('deleteModal');
            const closeModal = document.getElementById('closeModal');
            const cancelBtn = document.getElementById('cancelBtn');
            const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
            const deleteForm = document.getElementById('deleteForm');

            if (deleteBtn && deleteModal) {
                // Open modal when delete button is clicked
                deleteBtn.addEventListener('click', function () {
                    deleteModal.style.display = 'flex';
                });

                // Close modal functions
                function closeModalFunc() {
                    deleteModal.style.display = 'none';
                }

                closeModal?.addEventListener('click', closeModalFunc);
                cancelBtn?.addEventListener('click', closeModalFunc);

                // Close modal when clicking outside
                deleteModal.addEventListener('click', function (e) {
                    if (e.target === deleteModal) {
                        closeModalFunc();
                    }
                });

                // Close modal on Escape key
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && deleteModal.style.display === 'flex') {
                        closeModalFunc();
                    }
                });

                // Confirm deletion
                confirmDeleteBtn?.addEventListener('click', function () {
                    if (deleteForm) {
                        deleteForm.submit();
                    }
                });
            }
        });
    </script>
}
