@model Website_Cosmetics.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}

<div class="page-header">
    <h1>Delete Product</h1>
</div>

<h3>Are you sure you want to delete this product?</h3>

<div class="card mt-4">
    <div class="card-body">
        <h4>@Model.Name</h4>
        <dl class="row">
            <dt class="col-sm-3">Brand:</dt>
            <dd class="col-sm-9">@(Model.Brand?.Name ?? "N/A")</dd>

            <dt class="col-sm-3">Category:</dt>
            <dd class="col-sm-9">@(Model.Category?.Name ?? "N/A")</dd>

            <dt class="col-sm-3">Base Price:</dt>
            <dd class="col-sm-9">@Model.BasePrice.ToString("C")</dd>

            <dt class="col-sm-3">Status:</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive == true)
                {
                    <span class="badge badge-success">Active</span>
                }
                else
                {
                    <span class="badge badge-danger">Inactive</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-4">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ProductId" />
    
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

