@model Website_Cosmetics.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title">Reset password</h1>
            <p class="auth-subtitle">Enter a new password for your account @Model.Email</p>
        </div>

        <form asp-action="ResetPassword" method="post" class="auth-form">
            @await Html.PartialAsync("_Alerts")
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />

            <div class="form-group">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-input" placeholder="New password" />
                <span asp-validation-for="Password" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-input" placeholder="Confirm new password" />
                <span asp-validation-for="ConfirmPassword" class="validation-error"></span>
            </div>

            <button type="submit" class="btn btn--brand btn--full">Reset password</button>

            <div class="auth-links">
                <a asp-action="Login" class="auth-link">Go back to sign in</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/public/css/authorize/auth.css" asp-append-version="true" />
}
