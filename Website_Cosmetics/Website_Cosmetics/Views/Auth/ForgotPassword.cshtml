@model Website_Cosmetics.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1 class="auth-title">Forgot password</h1>
            <p class="auth-subtitle">Enter your email to receive a password reset link</p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="auth-form">
            @await Html.PartialAsync("_Alerts")
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-input" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

            <button type="submit" class="btn btn--brand btn--full">Send password reset link</button>

            <div class="auth-links">
                <a asp-action="Login" class="auth-link">Go back to sign in</a>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/public/css/authorize/auth.css" asp-append-version="true" />
}
