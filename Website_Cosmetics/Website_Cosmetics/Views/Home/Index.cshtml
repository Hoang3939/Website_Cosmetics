                        </button>
                    }
                </div>
                <div class="product__body">
                    <div class="product__brand">@(product.Brand?.Name?.ToUpper() ?? "UNKNOWN")</div>
                    <h3 class="product__title">@product.Name</h3>
                    <div class="rating">
                        <img class="icon icon--star" src="/public/images/icons/star.png" alt="" aria-hidden="true" />
                        <span class="rating__score">4.8</span>
                        <span class="rating__count">(@(new Random().Next(100, 400)) reviews)</span>
                    </div>
                    <div class="product__price">
                        <span class="price--now">$@currentPrice.ToString("0.00")</span>
                        @if (hasDiscount)
                        {
                            <span class="price--old">$@comparePrice.ToString("0.00")</span>
                        }
                    </div>
                    <div class="product__actions">
                        <button type="button" class="btn" data-quickview>Quick view</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- View all for Sales -->
    <div class="container text-center mt-16">
        <a class="btn btn--brand" asp-controller="Deals" asp-action="Index">View All Deals</a>
    </div>
</section>

<!-- Explore the Collection -->
<section class="section">
    <div class="section__hd">
        <h2>Explore the Collection</h2>
        <p>Find the right products for your needs.</p>
    </div>

    <div class="container grid grid--categories">
        @{
            var collections = new[] {
        new { Name = "New & Trending",   Image = "/public/images/ui/collections-trending.png", Count = trendingCount, Action = "Trending" },
        new { Name = "Makeup",           Image = "/public/images/ui/collections-makeup.png",   Count = makeupCount, Action = "Makeup" },
        new { Name = "Tools & Brushes",  Image = "/public/images/ui/collections-tools.jpg",    Count = toolsCount,  Action = "Tools" },
        new { Name = "Gift & Value Sets",Image = "/public/images/ui/collections-gifts.jpg",    Count = giftsCount, Action = "Gifts" }
        };
        }
        @foreach (var c in collections)
        {
            <a class="collection-card" style="--bg: url('@c.Image')"
               asp-controller="Catalog" asp-action="@c.Action">
                <div class="collection-card__media" aria-hidden="true"></div>
                <div class="collection-card__caption">
                    <h3 class="collection-card__title">@c.Name</h3>
                    <p class="collection-card__meta">@c.Count products</p>
                </div>
            </a>
        }
    </div>
</section>
