@using Website_Cosmetics.Models
@{
    ViewData["Title"] = "Home";
    var mostLovedProducts = ViewData["MostLovedProducts"] as IEnumerable<Product> ?? new List<Product>();
    var onSaleProducts = ViewData["OnSaleProducts"] as IEnumerable<Product> ?? new List<Product>();
    var trendingCount = ViewData["TrendingCount"] as int? ?? 0;
    var makeupCount = ViewData["MakeupCount"] as int? ?? 0;
    var toolsCount = ViewData["ToolsCount"] as int? ?? 0;
    var giftsCount = ViewData["GiftsCount"] as int? ?? 0;
}

<!-- Banner -->
<section class="section hero">
    <div class="container">
        <div class="card hero-card">
            <img src="/public/images/banner/banner-blush.png" alt="Banner" />
        </div>
    </div>
</section>

<!-- Most Loved -->
<section class="section">
    <div class="section__hd">
        <h2>Most Loved</h2>
        <p>Top-rated products by our customers.</p>
    </div>

    <div class="container grid grid--products">
        @foreach (var product in mostLovedProducts)
        {
            // Get image from default variant's primary image, fallback to first variant image, then product image, then default
            var defaultVariant = product.ProductVariants?.FirstOrDefault(v => v.IsDefault == true && (v.IsActive == true || v.IsActive == null)) 
                                 ?? product.ProductVariants?.FirstOrDefault(v => v.IsActive == true || v.IsActive == null)
                                 ?? product.ProductVariants?.FirstOrDefault();
            var productImage = defaultVariant?.ProductVariantImages?.FirstOrDefault(img => img.IsPrimary)?.Url
                            ?? defaultVariant?.ProductVariantImages?.FirstOrDefault()?.Url
                            ?? product.ProductImages?.FirstOrDefault()?.Url
                            ?? "/public/images/products/img-cart-lip.png";
            // Get price from default variant (use variant.Price if exists, otherwise use product.BasePrice)
            var currentPrice = defaultVariant?.Price ?? product.BasePrice;
            // Compare price: use CompareAtPrice if exists, otherwise use BasePrice
            var comparePrice = defaultVariant?.CompareAtPrice ?? product.BasePrice;
            // Check if there's a discount: CompareAtPrice > currentPrice OR (variant.Price < BasePrice)
            var hasDiscount = (defaultVariant?.CompareAtPrice != null && defaultVariant.CompareAtPrice > currentPrice) 
                            || (defaultVariant?.Price != null && defaultVariant.Price < product.BasePrice);
            <div class="card product" data-product-id="@product.ProductId" data-details="@Url.Action("Details", "Products", new { id = product.ProductId })">
                <div class="product__header">
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductId" class="product__img">
                        <img src="@productImage" alt="@product.Name" />
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button type="button" class="product__wishlist-btn" data-product-id="@product.ProductId" aria-label="Add to wishlist">
                            <i data-lucide="heart" class="wishlist-icon"></i>
                        </button>
                    }
                </div>
                <div class="product__body">
                    <div class="product__brand">@(product.Brand?.Name?.ToUpper() ?? "UNKNOWN")</div>
                    <h3 class="product__title">@product.Name</h3>
                    <div class="rating">
                        <img class="icon icon--star" src="/public/images/icons/star.png" alt="" aria-hidden="true" />
                        <span class="rating__score">4.8</span>
                        <span class="rating__count">(@(new Random().Next(100, 400)) reviews)</span>
                    </div>
                    <div class="product__price">
                        <span class="price--now">$@currentPrice.ToString("0.00")</span>
                        @if (hasDiscount)
                        {
                            <span class="price--old">$@comparePrice.ToString("0.00")</span>
                        }
                    </div>
                    <div class="product__actions">
                        <button type="button" class="btn" data-quickview>Quick view</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="container text-center mt-16">
        <a class="btn" asp-controller="Products" asp-action="Index">View All Products</a>
    </div>
</section>

