<!-- Explore the Collection -->
<section class="section">
    <div class="section__hd">
        <h2>Explore the Collection</h2>
        <p>Find the right products for your needs.</p>
    </div>

    <div class="container grid grid--categories">
        @{
            var collections = new[] {
        new { Name = "New & Trending",   Image = "/public/images/ui/collections-trending.png", Count = 200, Slug = "new-trending" },
        new { Name = "Makeup",           Image = "/public/images/ui/collections-makeup.png",   Count = 420, Slug = "makeup" },
        new { Name = "Tools & Brushes",  Image = "/public/images/ui/collections-tools.jpg",    Count = 95,  Slug = "tools-brushes" },
        new { Name = "Gift & Value Sets",Image = "/public/images/ui/collections-gifts.jpg",    Count = 58,  Slug = "gifts" }
        };
        }
        @foreach (var c in collections)
        {
            <a class="collection-card" style="--bg: url('@c.Image')"
               asp-controller="Catalog" asp-action="Category" asp-route-slug="@c.Slug">
                <div class="collection-card__media" aria-hidden="true"></div>
                <div class="collection-card__caption">
                    <h3 class="collection-card__title">@c.Name</h3>
                    <p class="collection-card__meta">@c.Count products</p>
                </div>
            </a>
        }
    </div>
</section>
