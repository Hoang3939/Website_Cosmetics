@model IEnumerable<Website_Cosmetics.Models.UserAddress>
@{
    ViewData["Title"] = "My Addresses";
}

<section class="section">
    <div class="container">
        <div class="section__hd">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <h1>My Addresses</h1>
                    <p>Manage your shipping addresses.</p>
                </div>
                <a asp-controller="Address" asp-action="Create" class="btn btn--brand">Add New Address</a>
            </div>
        </div>

        @await Html.PartialAsync("_Alerts")

        @if (Model == null || !Model.Any())
        {
            <div class="addresses-empty">
                <div class="addresses-empty__icon">
                    <i data-lucide="map-pin"></i>
                </div>
                <h2 class="addresses-empty__title">No addresses saved</h2>
                <p class="addresses-empty__text">Add your first shipping address to get started!</p>
                <a asp-controller="Address" asp-action="Create" class="btn btn--brand">Add Address</a>
            </div>
        }
        else
        {
            <div class="addresses-grid">
                @foreach (var address in Model)
                {
                    <div class="address-card @(address.IsDefault ? "address-card--default" : "")">
                        <div class="address-card__header">
                            <div class="address-card__name-wrapper">
                                <h3 class="address-card__name">@address.FullName</h3>
                                @if (address.IsDefault)
                                {
                                    <span class="address-card__default-label">Default</span>
                                }
                            </div>
                            <div class="address-card__actions">
                                <a asp-controller="Address" asp-action="Edit" asp-route-id="@address.AddressId" class="btn btn--sm btn--secondary">Edit</a>
                                <form asp-controller="Address" asp-action="Delete" method="post" class="address-delete-form" onsubmit="return confirm('Are you sure you want to delete this address?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@address.AddressId" />
                                    <button type="submit" class="btn btn--sm btn--danger">Delete</button>
                                </form>
                            </div>
                        </div>
                        <div class="address-card__body">
                            <div class="address-card__phone">@(address.PhoneNumber ?? "No phone")</div>
                            <div class="address-card__address">
                                <div>@address.AddressLine1</div>
                                @if (!string.IsNullOrEmpty(address.AddressLine2))
                                {
                                    <div>@address.AddressLine2</div>
                                }
                                <div>@address.City, @(string.IsNullOrEmpty(address.State) ? "" : address.State + " ")@address.PostalCode</div>
                                <div>@address.Country</div>
                            </div>
                        </div>
                        @if (!address.IsDefault)
                        {
                            <div class="address-card__footer">
                                <form asp-controller="Address" asp-action="SetDefault" method="post" class="address-set-default-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@address.AddressId" />
                                    <button type="submit" class="btn btn--sm btn--link">Set as Default</button>
                                </form>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/public/css/pages/addresses.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const setDefaultForms = document.querySelectorAll('.address-set-default-form');
            
            setDefaultForms.forEach(form => {
                form.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    
                    const formData = new FormData(form);
                    const button = form.querySelector('button[type="submit"]');
                    const originalText = button.textContent;
                    
                    // Disable button
                    button.disabled = true;
                    button.textContent = 'Setting...';
                    
                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]').value
                            }
                        });
                        
                        const data = await response.json();
                        
                        if (data.success) {
                            // Show success toast
                            if (typeof Toast !== 'undefined' && typeof Toast.show === 'function') {
                                Toast.show(data.message || 'Default address updated successfully', 'success');
                            } else {
                                alert(data.message || 'Default address updated successfully');
                            }
                            
                            // Reload page after a short delay to show the toast
                            setTimeout(() => {
                                window.location.reload();
                            }, 1000);
                        } else {
                            // Show error toast
                            if (typeof Toast !== 'undefined' && typeof Toast.show === 'function') {
                                Toast.show(data.message || 'Failed to update default address', 'error');
                            } else {
                                alert(data.message || 'Failed to update default address');
                            }
                            
                            // Re-enable button
                            button.disabled = false;
                            button.textContent = originalText;
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        if (typeof Toast !== 'undefined' && typeof Toast.show === 'function') {
                            Toast.show('An error occurred. Please try again.', 'error');
                        } else {
                            alert('An error occurred. Please try again.');
                        }
                        
                        // Re-enable button
                        button.disabled = false;
                        button.textContent = originalText;
                    }
                });
            });
        });
    </script>
}

