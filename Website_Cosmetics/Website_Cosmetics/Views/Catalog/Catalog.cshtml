@model IEnumerable<Website_Cosmetics.Models.Product>
@{
    ViewData["Title"] = ViewBag.PageTitle ?? "Catalog";
    var pageTitle = ViewBag.PageTitle as string ?? "Products";
    var pageDescription = ViewBag.PageDescription as string ?? "Browse our collection";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalProducts = ViewBag.TotalProducts as int? ?? 0;
}

<section class="section">
    <div class="container">
        <div class="section__hd">
            <h1>@pageTitle</h1>
            <p>@pageDescription</p>
            @if (totalProducts > 0)
            {
                <p class="catalog-count">Showing @((currentPage - 1) * 12 + 1)-@(Math.Min(currentPage * 12, totalProducts)) of @totalProducts products</p>
            }
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="catalog-empty">
                <div class="catalog-empty__icon">
                    <i data-lucide="package"></i>
                </div>
                <h2 class="catalog-empty__title">No products found</h2>
                <p class="catalog-empty__text">We couldn't find any products matching your criteria.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn--brand">Back to Home</a>
            </div>
        }
        else
        {
            <div class="grid grid--products">
                @foreach (var product in Model)
                {
                    var productImage = product.ProductImages?.FirstOrDefault(img => img.ImageType == "cover")?.Url 
                                     ?? product.ProductImages?.FirstOrDefault()?.Url
                                     ?? "/public/images/products/img-cart-lip.png";
                    var minPrice = product.ProductVariants?.Where(v => v.Price.HasValue).Min(v => v.Price) ?? product.BasePrice;
                    var maxPrice = product.ProductVariants?.Where(v => v.Price.HasValue).Max(v => v.Price) ?? product.BasePrice;
                    var hasSale = product.ProductVariants?.Any(v => v.Price.HasValue && v.Price < product.BasePrice) == true;
                    var salePrice = hasSale ? product.ProductVariants?.Where(v => v.Price.HasValue && v.Price < product.BasePrice).Min(v => v.Price) : null;
                    
                    <div class="card product" data-product-id="@product.ProductId">
                        <div class="product__header">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductId" class="product__img">
                                <img src="@productImage" alt="@product.Name" />
                            </a>
                            @if (hasSale)
                            {
                                <span class="product__badge">Sale</span>
                            }
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <button type="button" class="product__wishlist-btn" data-product-id="@product.ProductId" aria-label="Add to wishlist">
                                    <i data-lucide="heart" class="wishlist-icon"></i>
                                </button>
                            }
                        </div>
                        <div class="product__body">
                            <div class="product__brand">@(product.Brand?.Name?.ToUpper() ?? "UNKNOWN")</div>
                            <h3 class="product__title">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.ProductId">@product.Name</a>
                            </h3>
                            @if (product.Rating.HasValue)
                            {
                                <div class="rating">
                                    <img class="icon icon--star" src="/public/images/icons/star.png" alt="" aria-hidden="true" />
                                    <span class="rating__score">@product.Rating.Value.ToString("0.0")</span>
                                    <span class="rating__count">(@product.ReviewCount reviews)</span>
                                </div>
                            }
                            <div class="product__price">
                                @if (hasSale && salePrice.HasValue)
                                {
                                    <span class="price--now">$@salePrice.Value.ToString("0.00")</span>
                                    <span class="price--old">$@product.BasePrice.ToString("0.00")</span>
                                }
                                else if (minPrice == maxPrice)
                                {
                                    <span class="price--now">$@minPrice.ToString("0.00")</span>
                                }
                                else
                                {
                                    <span class="price--now">$@minPrice.ToString("0.00") - $@maxPrice.ToString("0.00")</span>
                                }
                            </div>
                            <div class="product__actions">
                                <button type="button" class="btn" data-quickview>Quick view</button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <div class="pagination">
                    @if (currentPage > 1)
                    {
                        <a asp-action="@ViewContext.RouteData.Values["action"]" asp-route-page="@(currentPage - 1)" class="pagination__link pagination__link--prev">
                            <i data-lucide="chevron-left"></i>
                            Previous
                        </a>
                    }
                    
                    <div class="pagination__pages">
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            if (i == currentPage)
                            {
                                <span class="pagination__page pagination__page--active">@i</span>
                            }
                            else
                            {
                                <a asp-action="@ViewContext.RouteData.Values["action"]" asp-route-page="@i" class="pagination__page">@i</a>
                            }
                        }
                    </div>
                    
                    @if (currentPage < totalPages)
                    {
                        <a asp-action="@ViewContext.RouteData.Values["action"]" asp-route-page="@(currentPage + 1)" class="pagination__link pagination__link--next">
                            Next
                            <i data-lucide="chevron-right"></i>
                        </a>
                    }
                </div>
            }
        }
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/public/css/pages/catalog.css" asp-append-version="true" />
}

