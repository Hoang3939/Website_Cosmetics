@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Cosmetic</title>
    <link rel="stylesheet" href="~/public/css/site.css" asp-append-version="true" />
    <script src="https://unpkg.com/lucide@latest"></script>
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Header -->
    <header class="header">
        <div class="container header__row">
            <div class="header__brand">COSMETIC</div>
            <div class="header__search">
                <input placeholder="Search products, brands..." />
            </div>
            <div class="header__actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="header__welcome">Hello, @User.Identity.Name!</span>
                    <form asp-controller="Auth" asp-action="LogoutConfirmed" method="post" style="display: inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn">Logout</button>
                    </form>
                }
                else
                {
                    <a class="btn" asp-controller="Auth" asp-action="Login">Sign in</a>
                    <a class="btn btn--brand" asp-controller="Auth" asp-action="Register">Sign up</a>
                }
                <button class="btn btn--icon" aria-label="Open cart">
                    <img class="icon icon--cart" src="/public/images/icons/cart.png" alt="" />
                </button>
            </div>
        </div>
        <nav class="navbar">
            <div class="container navbar__row">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Catalog" asp-action="Trending">New & Trending</a>
                <a asp-controller="Catalog" asp-action="Makeup">Makeup</a>
                <a asp-controller="Catalog" asp-action="Tools">Tools & Brushes</a>
                <a asp-controller="Deals" asp-action="Index">Sale & Offers</a>
            </div>
        </nav>
    </header>

    <!-- Page content -->
    <main class="container">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container footer__grid">
            <section class="footer__col">
                <h4>Links</h4>
                <div class="grid grid--tight">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Catalog" asp-action="Trending">New & Trending</a>
                    <a asp-controller="Catalog" asp-action="Makeup">Makeup</a>
                    <a asp-controller="Catalog" asp-action="Tools">Tools & Brushes</a>
                    <a asp-controller="Deals" asp-action="Index">Sale & Offers</a>
                </div>
            </section>
            <section class="footer__col">
                <h4>Explore</h4>
                <div class="grid grid--tight">
                    <a href="#">Resources</a><a href="#">Blog</a><a href="#">Documents</a>
                </div>
            </section>
            <section class="footer__col">
                <h4>Company</h4>
                <div class="grid grid--tight">
                    <a href="#">About us</a><a href="#">Partners</a><a href="#">Contact</a>
                </div>
            </section>
            <section class="footer__col">
                <h4>Sign up for Cosmetic Emails</h4>
                <form>
                    <div class="hstack">
                        <input class="input input--dark" placeholder="Email address" />
                        <button class="btn btn--brand" type="button">→</button>
                    </div>
                    <p class="muted mt-10">We send news and offers—no spam.</p>
                </form>
            </section>
        </div>

        <div class="container footer__btm">
            <div>COSMETIC</div>
            <div class="footer__links"><a href="#">Terms</a><a href="#">Privacy</a><a href="#">Cookies</a></div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/public/js/components/modal.js" asp-append-version="true"></script>
    <script src="~/public/js/components/toast.js" asp-append-version="true"></script>
    <script src="~/public/js/components/quickview.js" asp-append-version="true"></script>
    <script src="~/public/js/core/site.js" asp-append-version="true"></script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
